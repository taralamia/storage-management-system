{
  "extends": ["airbnb-base", "prettier"], // Airbnb first for rules, Prettier to override formatting
  "parserOptions": {
    "ecmaVersion": 12
  },
  "env": {
    "node": true,
    "commonjs": true
  },
  "rules": {
    "no-console": "off", // Example: Disable console.log warnings
    
    "prefer-const": "off", // Enforce const for unchanged variables
    "quotes": ["error", "single"], // Enforce single quotes
    "semi": ["error", "always"], // Enforce semicolons
    "prettier/prettier": "error" // Prettier formatting rules
  },
  "plugins": ["prettier"]
}
