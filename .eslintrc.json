{
  "extends": ["airbnb-base", "prettier"], // Airbnb first for rules, Prettier to override formatting
  "parserOptions": {
    "ecmaVersion": 12
  },
  "env": {
    "node": true,
    "commonjs": true
  },
  "rules": {
    "no-console": "off", // Example: Disable console.log warnings
    "no-var": "error", // Disallows var, use let/const instead
    "prefer-const": ["error", {
      "destructuring": "all", // Enforce const for all destructured variables if possible
      "ignoreReadBeforeAssign": false // Always prefer const if variable isn't reassigned
    }],
    "quotes": ["error", "single"], // Enforce single quotes
    "semi": ["error", "always"], // Enforce semicolons
    "prettier/prettier": ["error", { "singleQuote": true }]// Prettier formatting rules
  },
  "plugins": ["prettier"]
}
